# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt
mono_crash.*.blob
mono_crash.*.json

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# unity-dev skill
.claude/preflight/
.claude/settings.local.json
.claude/hooks/__pycache__/
.claude/worktrees/
.claude/**/__pycache__/
*.slnx

# Firebase Unity SDK — VENDOR, re-imported rather than committed (decisions.md D-148).
# It is 250 MB across 148 files, and FirebaseCppApp-13_16_0.bundle alone is 106 MB --
# past GitHub's 100 MB hard limit, so committing it would make the repo unpushable the
# day a remote is added, and unpicking it from history afterwards means a rewrite.
# A fresh clone re-imports the SDK (App is bundled inside Auth/Firestore; do NOT import
# FirebaseAnalytics) and then clears the Gatekeeper quarantine on the .bundle natives:
#   xattr -r -d com.apple.quarantine ExpoTheExplorer/Assets/Firebase/Plugins/x86_64
/ExpoTheExplorer/Assets/Firebase/*
/ExpoTheExplorer/Assets/ExternalDependencyManager/
/ExpoTheExplorer/Assets/ExternalDependencyManager.meta

# ...but the CONFIG is kept: tiny, and it is this project's Firebase identity. Without
# these the SDK cannot initialise, and re-downloading them means going back to the
# console. They are client config, not secrets -- Firestore security lives in the rules.
!/ExpoTheExplorer/Assets/Firebase/google-services.json
!/ExpoTheExplorer/Assets/Firebase/google-services.json.meta
!/ExpoTheExplorer/Assets/Firebase/GoogleService-Info.plist
!/ExpoTheExplorer/Assets/Firebase/GoogleService-Info.plist.meta

# The SDK also scatters files OUTSIDE Assets/Firebase/, and they are ignored for the
# same reason plus one more: half a committed SDK is worse than none, because a fresh
# clone would then hold stale .meta files that a re-import has to fight.
/ExpoTheExplorer/Assets/Plugins/iOS/Firebase/
/ExpoTheExplorer/Assets/Plugins/iOS/Firebase.meta
/ExpoTheExplorer/Assets/Plugins/tvOS/
/ExpoTheExplorer/Assets/Plugins/tvOS.meta
/ExpoTheExplorer/Assets/Editor Default Resources/Firebase/
/ExpoTheExplorer/Assets/Editor Default Resources/Firebase.meta

# Telemetry analysis (tools/telemetry_report.py).
# The service account key is a REAL credential -- it bypasses Firestore's security
# rules by design, which is exactly why the game client never gets one. Anyone
# holding this file can read and delete every playtest run. It never goes in the
# repo, and it does not belong on a shared drive either.
*serviceaccount*.json
*service-account*.json
*-firebase-adminsdk-*.json
/tools/telemetry-report.html
