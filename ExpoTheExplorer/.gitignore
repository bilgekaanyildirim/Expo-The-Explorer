# This .gitignore file should be placed at the root of your Unity project

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
UserSettings/

# Asset meta data should only be ignored when the corresponding asset is ignored
!/[Aa]ssets/**/*.meta
!/[Pp]ackages/**/*.meta
!/[Pp]rojectSettings/**/*.meta

# Visual Studio / Rider
.vs/
.vscode/
.idea/
.gradle/

ExportedObj/
.consulo/

*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated
sysinfo.txt

# Crash reports
sysinfo.txt
*.stacktrace

# Build outputs
*.apk
*.aab
*.ipa

# Addressables
ServerData/

# Android
.gradle/
local.properties

# iOS
DerivedData/

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# JetBrains Rider
.idea/

# Visual Studio Code
.vscode/*

# Except recommended VSCode files
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Unity cache
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Recordings
Recordings/

# Test results
TestResults/

# Burst
[Bb]urstDebugInformation_DoNotShip/

# Memory Captures
MemoryCaptures/

# Temporary auto-generated files
*.tmp
*.bak
*.orig

# Coverage reports
Coverage/
# Firebase SDK folder metas — the other half of the rule this file already states
# above ("meta data should only be ignored when the corresponding asset is ignored").
# The repo-root .gitignore drops the SDK itself (decisions.md D-148); without these
# lines the `!/[Aa]ssets/**/*.meta` negation above would keep their folder metas, and
# a fresh clone would open Unity holding metas for folders that are not there -- which
# Unity then deletes on import, dirtying the working tree before anyone has done
# anything. Assets/Firebase.meta is deliberately NOT here: that folder keeps its two
# config files, so its own meta is real.
/Assets/Firebase/Editor.meta
/Assets/Firebase/FirebaseApp.meta
/Assets/Firebase/Plugins.meta
/Assets/Firebase/m2repository.meta
/Assets/ExternalDependencyManager.meta
/Assets/Plugins/iOS/Firebase.meta
/Assets/Plugins/tvOS.meta
/Assets/Editor Default Resources/Firebase.meta
